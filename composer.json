{
  "name": "mws/manifestador-web",
  "type": "project",
  "description": "MWS Manifestador NF-e Web/API.",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^1.3",
    "laravel/framework": "^11.0",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^2.9",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.4",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.4",
    "rector/rector": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": [
      "@pint-test",
      "@phpstan"
    ],
    "fix": [
      "pint",
      "rector process"
    ],
    "pint": "pint",
    "pint-test": "pint --test",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "rector": "rector process --dry-run",
    "test": "phpunit --colors=always",
    "quality": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.20"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
