{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint resources/js --max-warnings=0",
    "lint:fix": "eslint resources/js --fix",
    "format": "prettier --write \"resources/**/*.{js,ts,vue,css,json}\" \"{eslint.config,vite.config}.ts\" \"*.{js,ts}\" package.json package-lock.json tsconfig.json pint.json .prettierrc.json",
    "format:check": "prettier --check \"resources/**/*.{js,ts,vue,css,json}\" \"{eslint.config,vite.config}.ts\" \"*.{js,ts}\" package.json package-lock.json tsconfig.json pint.json .prettierrc.json",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@inertiajs/vue3": "^1.0.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "laravel-vite-plugin": "^1.2.0",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vue-tsc": "^2.2.0"
  }
}
